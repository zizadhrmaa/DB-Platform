# Salin ke .env lalu isi. Jangan commit file .env.
APP_ENV=development
APP_ADDR=:8080
DATABASE_URL=postgres://platform:platform@localhost:5432/dbplatform?sslmode=disable
# make keygen  (32 byte base64). Jika diganti, password koneksi DB yang tersimpan harus diisi ulang.
APP_SECRET_KEY=
# Platform Admin pertama (hanya dibuat jika belum ada admin sama sekali)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Login sementara sebagai user ini sampai fitur login selesai.
# Tidak boleh diisi di production.
DEV_AUTH_USER_ID=