# Salin ke .env lalu isi. Jangan commit file .env.
APP_ENV=development
APP_ADDR=:8080
DATABASE_URL=postgres://platform:platform@localhost:5432/dbplatform?sslmode=disable
# make keygen  (32 byte base64). Jika diganti, password koneksi DB yang tersimpan harus diisi ulang.
APP_SECRET_KEY=
# Platform Admin pertama (hanya dibuat jika belum ada admin sama sekali)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Hanya untuk pengembangan lokal, semua request dianggap login sebagai user ini.
# Tidak boleh diisi di production.
DEV_AUTH_USER_ID=
METRICS_TOKEN=
# Worker antrean migration. Matikan (false) kalau worker dijalankan di proses lain.
WORKER_ENABLED=true
# Jumlah job yang boleh berjalan bersamaan (database berbeda) di proses ini.
WORKER_CONCURRENCY=2
# Batas waktu eksekusi satu job, juga dipakai sebagai statement_timeout.
JOB_TIMEOUT=30m