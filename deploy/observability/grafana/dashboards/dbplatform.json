        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (db) (dbp_job_retries_total)",
          "legendFormat": "retry - {{db}}",
          "refId": "A"
        }
      ],
      "title": "Job Retries",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
